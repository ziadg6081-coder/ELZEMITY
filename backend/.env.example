# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development            # development | production | test
PORT=3000
# Public origin(s) of the site (comma separated). MUST be https:// in production. Used for CORS, CSRF origin check, Socket.IO.
APP_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of Node (1 for nginx). Needed for correct client IPs / rate limiting.
TRUST_PROXY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=oriantal_perfumes
DB_USER=root
DB_PASSWORD=
# DB_SSL=true                   # enable when MySQL is on another host
# DB_SSL_CA=/path/to/ca.pem

# Optional: separate (more privileged) account used ONLY by `npm run migrate` / setup
# DB_MIGRATION_USER=oriantal_migrator
# DB_MIGRATION_PASSWORD=change-me

SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
LOG_DIR=logs
LOG_LEVEL=info

# Backups
BACKUP_DIR=backups
BACKUP_OFFSITE_DIR=             # e.g. a mounted remote disk / synced folder (outside this server)
BACKUP_KEEP=14
BACKUP_ENCRYPTION_KEY=          # 64 hex chars:  openssl rand -hex 32   (store a copy somewhere safe, OFF the server!)

# --- Telegram order alerts (optional) ---
# 1) Create a bot with @BotFather and paste its token. 2) Send any message to your bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}. Several chats: comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Password recovery (SMTP; only on backend; never publish these values)
# Public origin of the same server that hosts /reset-password.html and /api
PUBLIC_SITE_ORIGIN=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
