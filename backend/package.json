{
  "name": "oriantal-perfumes",
  "version": "1.0.0",
  "description": "Oriantal Perfumes - e-commerce store (Express + MySQL + Socket.IO)",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "setup": "node scripts/setup.js",
    "migrate": "node scripts/migrate.js",
    "repair:orders": "node scripts/repair-order-items.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "build:sql": "node scripts/build-sql.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "10.3.1",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
